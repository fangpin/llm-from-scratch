---
interface Props {
  metrics: { value: string; label: string }[];
}

const { metrics } = Astro.props;
---

<section class="section">
  <div class="proof-band">
    {metrics.map((metric) => (
      <article class="metric-card">
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </article>
    ))}
  </div>
</section>
